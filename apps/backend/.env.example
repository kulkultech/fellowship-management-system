APP_ENV=development
HTTP_PORT=8080
DATABASE_URL=postgres://fms_user:fms_dev_password@localhost:5432/fms_dev?sslmode=disable
JWT_SECRET=development-jwt-secret-key-32characters-long!!
JWT_TTL_MINUTES=1440
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
COOKIE_SECURE=false
COOKIE_DOMAIN=
METRICS_TOKEN=
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./uploads
R2_BUCKET=fellowhire
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=

# Cloudflare Configuration (Workers AI & R2)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_KEY=

# Google OAuth 2.0 Configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/oauth/google/callback
OAUTH_FRONTEND_SUCCESS_URL=http://localhost:5173/admin/dashboard

# Google Calendar & Meet Integration
# GOOGLE_SERVICE_ACCOUNT_JSON is a path to the service account key file, or the raw JSON.
# GOOGLE_CALENDAR_IMPERSONATE is the Workspace user the service account acts as; it needs
# domain-wide delegation with scope https://www.googleapis.com/auth/calendar.events, and without
# it Google refuses to invite attendees or add Meet links. "primary" is that user's own calendar.
GOOGLE_CALENDAR_ID=primary
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_IMPERSONATE=

# GitHub contribution tracking (optional). A token raises the API rate limit
# from 60 to 5000 requests/hour and allows private repositories.
# Fine-grained token with read-only access to the tracked repositories.
GITHUB_TOKEN=

# Live session workspace (optional). Required when running more than one backend
# instance so participants on different instances see each other's edits.
# e.g. redis://:password@redis:6379/0
REDIS_URL=

# Platform superadmins (Superadmin Portal + every company dashboard), comma-separated.
# Listed accounts are made superadmin on every sign-in, so they can't be a company's mentor
# or admin. SUPERADMIN_DOMAINS makes a whole domain superadmin; leave it empty unless that
# is really intended.
SUPERADMIN_EMAILS=superadmin@fellowhire.com
SUPERADMIN_DOMAINS=

# Sentry Crash Analytics
SENTRY_DSN=https://examplePublicKey@o000000.ingest.sentry.io/0000000



